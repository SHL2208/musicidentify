# Google AI Studio API Key (Lấy miễn phí tại: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection: gemini-3.1-flash-lite (siêu nhanh) hoặc gemini-3.5-flash-lite (thẩm âm sâu)
DEFAULT_GEMINI_MODEL=gemini-3.1-flash-lite

# Cấu hình xử lý Audio
AUDIO_SAMPLE_DURATION=30
AUDIO_SAMPLE_OFFSET=45

# Giới hạn xử lý hàng loạt (giây nghỉ giữa các bài để đảm bảo Free Tier)
BATCH_SLEEP_INTERVAL=3.0
