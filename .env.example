# Google AI Studio API Key (Lấy miễn phí tại: https://aistudio.google.com/app/apikey)
# Cấu hình đa tầng dự phòng tự động (thứ tự 1 > 2 > 3):
GEMINI_API_KEY_1=your_gemini_api_key_1
GEMINI_API_KEY_2=your_gemini_api_key_2
GEMINI_API_KEY_3=your_gemini_api_key_3
# (Tùy chọn) Key đơn lẻ tương thích cũ:
# GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection: Gemini 3.8 Flash (chính) -> Gemini 3.7 Flash -> Gemini 3.6 Flash
# Cơ chế failover 2 tầng: Thử cả 3 keys với 3.8 Flash, nếu cả 3 key cạn quota/lỗi -> chuyển sang 3.7 Flash (3 keys) -> rồi đến 3.6 Flash
DEFAULT_GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash

# Cấu hình xử lý Audio
AUDIO_SAMPLE_DURATION=30
AUDIO_SAMPLE_OFFSET=45

# Giới hạn xử lý hàng loạt (giây nghỉ giữa các bài để đảm bảo Free Tier)
BATCH_SLEEP_INTERVAL=3.0

# Cấu hình REST API Server
API_HOST=0.0.0.0
API_PORT=8000

